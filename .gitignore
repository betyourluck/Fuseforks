# Cargo ワークスペースのビルド成果物（target はルートに集約される）
/target

# フロントエンド
node_modules
dist
.vite

# 秘密。API キーの実値はモデルテンプレートに書かず、環境変数で渡す方針だが、
# ローカルの .env を誤ってコミットしないよう二重に塞いでおく。
.env
.env.*
!.env.example

# OS / エディタ
.DS_Store
Thumbs.db
*.swp

# 村の黒板（共有作業メモ）。work_dir がこのリポジトリを指しているため、
# エージェントの付箋がここに生まれる。黒板は「作業の寿命」の共有記憶であって
# リポジトリの内容物ではない — コミットすると作業メモが公開リポジトリへ漏れる。
blackboard/

# 開発機ローカルの道具置き場（tla2tools.jar など）。第三者バイナリは
# リポジトリの内容物ではない — 入れ方は specs/tla/*.tla 冒頭の「回し方」が正。
extra/

# 会話の保存先（Spec 12）。既定では {workspace} = %APPDATA%\jp.outcasts.fuseforks\ の
# 配下に生まれるのでリポジトリには入らないが、workspace をリポジトリ内へ置く運用の
# 保険として塞いでおく。**会話はディスクに平文で残る**（伏せ字保存は会話の再現性を
# 壊すため採らない。中身は export_session で確認できる）。
sessions.redb
sessions.redb.lock
