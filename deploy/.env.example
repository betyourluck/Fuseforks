# .env へ写して埋める（.env は git に入れない）。compose.yaml の env_file で fuseforks にだけ渡る。
# 手で書く代わりに、bake --env-out deploy/.env で GUI の資格情報ストアから書き出せる（Spec 66）。

# 時刻帯。bake.json の sourceTimeZone と同じ値（daily / weekly の予定が GUI と同じ時刻に発火する）。
# 違えば起動前検査が TIMEZONE_MISMATCH で名指しする。
TZ=Asia/Tokyo

# モデルテンプレートの鍵。テンプレート ID を大文字にし、英数字以外を _ にした名前。
#   claude_sonnet → FUSEFORKS_SECRET_CLAUDE_SONNET
# 足りなければ起動前検査が SECRET_MISSING で変数名を書く。
# FUSEFORKS_SECRET_CLAUDE_SONNET=

# MCP の headers の ${secret:NAME} → FUSEFORKS_SECRET_MCP_<NAME>
# FUSEFORKS_SECRET_MCP_OUTCASTS=

# 扉の合鍵（compose.door.yaml で --door-port を渡すときだけ要る）
# FUSEFORKS_SECRET_DOOR_TOKEN=

# Jev（ツール結果の圧縮を ON にした村だけ）
# FUSEFORKS_SECRET_JEV_API_TOKEN=

# compose.door.yaml の Caddy が使うドメイン（compose の変数展開で Caddy にだけ渡る）
# FUSEFORKS_DOMAIN=fuseforks.example.com
