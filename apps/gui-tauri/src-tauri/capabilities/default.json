{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限。decorations:false のカスタム TitleBar 用に window 操作権限を付与。opener の open-path は権限名だけでは全パス拒否 — scope（許可パス）を書いて初めて通る。開けるのはワークスペース配下（$APPDATA = app_data_dir）だけに絞る。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/workspace" },
        { "path": "$APPDATA/workspace/**" }
      ]
    },
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
